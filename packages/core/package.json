{
  "name": "sf-decomposer-core",
  "description": "Decompose and recompose Salesforce metadata without the Salesforce CLI: a standalone sf-decomposer command and programmatic API.",
  "version": "7.16.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./lib/index.d.ts",
  "bin": {
    "sf-decomposer": "./lib/cli/index.js"
  },
  "files": [
    "lib",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "config-disassembler": "4.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepack": "npm run --prefix ../.. build:core"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Matt Carvin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcarvin8/sf-decomposer.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mcarvin8/sf-decomposer/issues"
  },
  "homepage": "https://github.com/mcarvin8/sf-decomposer/tree/main/packages/core#readme",
  "keywords": [
    "salesforce",
    "salesforcedx",
    "metadata",
    "decompose",
    "recompose",
    "xml",
    "version-control",
    "cli"
  ]
}
